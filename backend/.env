# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Configuration
FIREBASE_DATABASE_URL=https://kuber-app-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT={}

# API Keys
# Brave API
BRAVE_API_URL=https://api.brave.com
BRAVE_API_KEY=your_brave_api_key

# Kite Connect API
KITE_CONNECT_API_URL=https://api.kite.trade
KITE_CONNECT_API_KEY=your_kite_connect_api_key
KITE_CONNECT_API_SECRET=your_kite_connect_api_secret

# Yahoo Finance API
YAHOO_FINANCE_API_URL=https://yfapi.net
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key

# Claude API
CLAUDE_API_URL=https://api.anthropic.com
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7
